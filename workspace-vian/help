class DesignTemplatesController < ApplicationController
  def new
    @template = Template.new
    @projects = current_user.projects
  end

  def save
    @template = Template.new(template_params)
    if @template.save
   redirect_to award_credentials_path(project_id: @template.project_id), notice: 'Credential template saved successfully.'
else
      render :new
    end
  end
  

  private

  def template_params
    params.require(:template).permit(:project_id, :name_of_certificate, :issuing_institution, :write_up, :edit_template_img)
  end
end



class AwardCredentialsController < ApplicationController
  def index
    @templates = current_user.projects.includes(:templates)  # Use includes to fetch associated templates
end
  def create
    # Logic to create credentials (e.g., saving to the database)
    # ...
    redirect_to award_credentials_path, notice: 'Credentials awarded successfully!'
  end
end








